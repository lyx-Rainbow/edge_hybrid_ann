# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so

# ===== 临时备份 / 会话日志 =====
*.bak_*
dsh-session-*.zip

# ===== 数据集文件 (Dataset files, ~27GB) =====
# 排除 1_Data 下的所有数据文件，仅保留 Python 脚本
1_Data/*
!1_Data/*.py

# ===== 数据 flush 到外存中生成的文件 (Disk data flushed to external storage) =====
4_Results/*/disk_data/
4_Results/*/disk_data_sweep/
4_Results/*/disk_data_build_sweep/
4_Results/*/disk_data_memprof/

# ===== 实验结果数据不入版本库（仅保留 fig_full 可视化输出）=====
4_Results/*
!4_Results/fig_full/
!4_Results/fig_full/**

# ===== 归档区的二进制中间数据（仅保留目录引用，不纳入版本库）=====
4_Results/_legacy/*/disk_data*/
4_Results/_legacy/*/test_sweep/
4_Results/_legacy/*/disk_data

# ===== 顶层大文件 =====
/curator_flash_20353.bin

# ===== SPTAG 硬编码索引输出目录（构建时自动生成）=====
/SPANN/

# ===== 各索引方法的 description.md 文档 =====
**/description.md
!1_Data/description.md

# ===== 缓存目录 =====
.cache/
**/.cache/

# ===== 日志 =====
logs/

# ===== 各方法的 CMake 构建产物 =====
**/build/

# ===== SPTAG 外部数据集 =====
SPANN-PostFiltering/SPTAG-main/datasets/

